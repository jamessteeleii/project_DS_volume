library(tidyverse)
library(glmmTMB)
library(marginaleffects)
library(ggdist)
library(patchwork)
data <- readxl::read_xlsx("data/PD_volume_data.xlsx")
glimpse(data)
long_data <- data |>
group_by(site) |>
mutate(site_id = cur_group_id()) |>
ungroup() |>
mutate(timepoint = factor(time, levels = c("Pre", "Post"))) |>
mutate(
time = case_when(
timepoint == "Pre" ~ 0,
timepoint == "Post" ~ 1,
.default = NA_real_
),
condition = case_when(
str_detect(str_to_lower(condition), "low") ~ "low",
str_detect(str_to_lower(condition), "high") ~ "high",
TRUE ~ NA_character_
)
) |>
mutate(
thigh_ma_1 =(4.68*thigh_circum_1)-(2.09*thigh_skinfold_1)-80.99,
thigh_ma_2 =(4.68*thigh_circum_2)-(2.09*thigh_skinfold_2)-80.99,
thigh_ma_3 =(4.68*thigh_circum_3)-(2.09*thigh_skinfold_3)-80.99,
arm_ma_1 = if_else(sex == "M" ,((arm_circum_1 - (pi * (arm_skinfold_1/10)))^2 / (4*pi))-10, ((arm_circum_1 - (pi * (arm_skinfold_1/10)))^2 / (4*pi))-6.5),
arm_ma_2 = if_else(sex == "M" ,((arm_circum_2 - (pi * (arm_skinfold_2/10)))^2 / (4*pi))-10, ((arm_circum_2 - (pi * (arm_skinfold_2/10)))^2 / (4*pi))-6.5),
arm_ma_3 = if_else(sex == "M" ,((arm_circum_3 - (pi * (arm_skinfold_3/10)))^2 / (4*pi))-10, ((arm_circum_3 - (pi * (arm_skinfold_3/10)))^2 / (4*pi))-6.5)
) |>
select(site_id, participant_id, condition, time, timepoint, contains("ma_")) |>
pivot_longer(6:11,
names_to = "muscle",
values_to = "estimated_ma") |>
mutate(
measurement = case_when(
str_detect(muscle, "1") == TRUE ~ 1,
str_detect(muscle, "2") == TRUE ~ 2,
str_detect(muscle, "3") == TRUE ~ 3
),
muscle = case_when(
str_detect(muscle, "thigh") == TRUE ~ "thigh",
str_detect(muscle, "arm") == TRUE ~ "arm"
)
) |>
mutate(cond_dummy = case_when(
condition == "low" ~ -0.5,
condition == "high" ~ 0.5
),
) |>
select(site_id, participant_id, condition, cond_dummy, time, timepoint, muscle, estimated_ma)
long_data_thigh <- long_data |>
filter(muscle == "thigh")
std_lm_thigh <- lm(estimated_ma ~ cond_dummy,
data = long_data_thigh)
std_thigh <- summary(std_lm_thigh)$sigma
long_data_thigh <- long_data_thigh |>
mutate(
estimated_ma_z = (estimated_ma - mean(estimated_ma, na.rm=TRUE)) / std_thigh
)
long_data_arm <- long_data |>
filter(muscle == "arm")
std_lm_arm <- lm(estimated_ma ~ cond_dummy,
data = long_data_arm)
std_arm <- summary(std_lm_arm)$sigma
long_data_arm <- long_data_arm |>
mutate(
estimated_ma_z = (estimated_ma - mean(estimated_ma, na.rm=TRUE)) / std_arm
)
long_data <- bind_rows(long_data_thigh, long_data_arm) |>
mutate(
outcome_dummy = case_when(
muscle == "arm" ~ -0.5,
muscle == "thigh" ~ 0.5
)
)
model <- glmmTMB(estimated_ma_z ~ time + time:cond_dummy + (1|site_id) + (1 | participant_id),
dispformula = ~ outcome_dummy,
data = long_data, REML = TRUE)
long_data <- data |>
group_by(site) |>
mutate(site_id = cur_group_id()) |>
ungroup() |>
mutate(timepoint = factor(time, levels = c("Pre", "Post"))) |>
mutate(
time = case_when(
timepoint == "Pre" ~ 0,
timepoint == "Post" ~ 1,
.default = NA_real_
),
condition = case_when(
str_detect(str_to_lower(condition), "low") ~ "low",
str_detect(str_to_lower(condition), "high") ~ "high",
TRUE ~ NA_character_
)
) |>
mutate(
thigh_ma_1 =(4.68*thigh_circum_1)-(2.09*thigh_skinfold_1)-80.99,
thigh_ma_2 =(4.68*thigh_circum_2)-(2.09*thigh_skinfold_2)-80.99,
thigh_ma_3 =(4.68*thigh_circum_3)-(2.09*thigh_skinfold_3)-80.99,
arm_ma_1 = if_else(sex == "M" ,((arm_circum_1 - (pi * (arm_skinfold_1/10)))^2 / (4*pi))-10, ((arm_circum_1 - (pi * (arm_skinfold_1/10)))^2 / (4*pi))-6.5),
arm_ma_2 = if_else(sex == "M" ,((arm_circum_2 - (pi * (arm_skinfold_2/10)))^2 / (4*pi))-10, ((arm_circum_2 - (pi * (arm_skinfold_2/10)))^2 / (4*pi))-6.5),
arm_ma_3 = if_else(sex == "M" ,((arm_circum_3 - (pi * (arm_skinfold_3/10)))^2 / (4*pi))-10, ((arm_circum_3 - (pi * (arm_skinfold_3/10)))^2 / (4*pi))-6.5)
) |>
select(site_id, participant_id, condition, sex, age, body_mass, height, rt_experience, time, timepoint, contains("ma_")) |>
pivot_longer(11:16,
names_to = "muscle",
values_to = "estimated_ma") |>
mutate(
measurement = case_when(
str_detect(muscle, "1") == TRUE ~ 1,
str_detect(muscle, "2") == TRUE ~ 2,
str_detect(muscle, "3") == TRUE ~ 3
),
muscle = case_when(
str_detect(muscle, "thigh") == TRUE ~ "thigh",
str_detect(muscle, "arm") == TRUE ~ "arm"
)
) |>
mutate(cond_dummy = case_when(
condition == "low" ~ -0.5,
condition == "high" ~ 0.5
),
) |>
mutate(sex = case_when(
sex == "F" ~ -0.5,
sex == "M" ~ 0.5
),
) |>
select(site_id, participant_id, condition, cond_dummy, sex, age, body_mass, height, rt_experience, time, timepoint, muscle, estimated_ma)
long_data_thigh <- long_data |>
filter(muscle == "thigh")
std_lm_thigh <- lm(estimated_ma ~ cond_dummy,
data = long_data_thigh)
std_thigh <- summary(std_lm_thigh)$sigma
long_data_thigh <- long_data_thigh |>
mutate(
estimated_ma_z = (estimated_ma - mean(estimated_ma, na.rm=TRUE)) / std_thigh
)
long_data_arm <- long_data |>
filter(muscle == "arm")
std_lm_arm <- lm(estimated_ma ~ cond_dummy,
data = long_data_arm)
std_arm <- summary(std_lm_arm)$sigma
long_data_arm <- long_data_arm |>
mutate(
estimated_ma_z = (estimated_ma - mean(estimated_ma, na.rm=TRUE)) / std_arm
)
long_data <- bind_rows(long_data_thigh, long_data_arm) |>
mutate(
outcome_dummy = case_when(
muscle == "arm" ~ -0.5,
muscle == "thigh" ~ 0.5
)
)
model_cov <- glmmTMB(estimated_ma_z ~ time + time:cond_dummy + sex + age + body_mass + height + rt_experience + (1|site_id) + (1 | participant_id),
dispformula = ~ outcome_dummy,
data = long_data, REML = TRUE)
model
model_cov
avg_predictions(model, by = "condition")
avg_predictions(model_cov, by = "condition")
View(long_data)
