exercise = str_to_lower(exercise)
) |>
filter(
str_detect(exercise, "press|press|row|curl|deadlift|triceps|biceps|ext|wpd|torso|ohp")
) |>
filter(
str_detect(exercise, "pend. neck ext.|shoulderhorn ext. rot",
negate = TRUE)
) |>
filter(
str_detect(exercise, "db incline hammer curl - l",
negate = TRUE)
) |>
filter(
str_detect(exercise, "db incline hammer curl - r",
negate = TRUE)
) |>
filter(
str_detect(exercise, "hammer wpd - l",
negate = TRUE)
) |>
filter(
str_detect(exercise, "hammer wpd - r",
negate = TRUE)
)  |>
group_by(participant, session, exercise) |>
slice(1) |>
ungroup() |>
filter(reps <= 20) |>
mutate(
set_type = case_when(
exercise == "aveng. leg press - mid" ~ "direct",
