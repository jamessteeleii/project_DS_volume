strength <- read_csv("data/pd_volume_workouts_data.csv") |>
select(-c(7:21)) |>
mutate(
session = case_when(
workout == "1" ~ session * 2 - 1,
workout == "2" ~ session * 2,
.default = session
)
) |>
mutate(
cond_dummy = case_when(
workout == "hv" ~ 0.5,
workout == "1" ~ -0.5,
workout == "2" ~ -0.5,
.default = NA_real_
),
time = session / 36
) |>
mutate(
condition = case_when(
workout == "hv" ~ "high",
workout == "1" ~ "low",
workout == "2" ~ "low",
.default = NA_character_
)
) |>
mutate(
session = case_when(
workout == "1" ~ session * 2 - 1,
workout == "2" ~ session * 2,
.default = session
)
) |>
mutate(
weight = parse_number(as.character(weight)),
reps   = parse_number(as.character(reps))
) |>
mutate(weight = if_else(weight < 0, weight * -1, weight),
reps = if_else(reps < 0, reps * -1, reps)) |>
mutate(
exercise = str_to_lower(exercise)
) |>
filter(
str_detect(exercise, "press|press|row|curl|deadlift|triceps|biceps|ext|wpd|torso|ohp")
